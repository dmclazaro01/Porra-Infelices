# Copy this file to .env and fill in your values

# Supabase (public - embedded in client build)
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY_HERE

# Supabase Service Role Key (NEVER expose to client - Docker/Edge Function only)
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY_HERE

# football-data.org API token (server-side only)
FOOTBALL_DATA_API_TOKEN=YOUR_FOOTBALL_DATA_TOKEN_HERE